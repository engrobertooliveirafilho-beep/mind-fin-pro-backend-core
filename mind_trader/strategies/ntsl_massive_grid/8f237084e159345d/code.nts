input
  fastPeriod(20);
  slowPeriod(34);

var
  fastMA, slowMA : Float;

begin
  fastMA := MediaExp(fastPeriod, Close);
  slowMA := MediaExp(slowPeriod, Close);

  if (fastMA > slowMA) and (fastMA[1] <= slowMA[1]) then
    BuyAtMarket;

  if (fastMA < slowMA) and (fastMA[1] >= slowMA[1]) then
    SellShortAtMarket;
end;